{
  "version": 2,
  "builds": [
    {
      "src": "src/web/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/web/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "src/web/server.js"
    }
  ],
  "env": {
    "SPOTIFY_CLIENT_ID": "@spotify_client_id",
    "SPOTIFY_CLIENT_SECRET": "@spotify_client_secret"
  }
}
