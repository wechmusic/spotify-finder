# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Spotify API Credentials
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Optional: For instant slash command registration (recommended for testing)
# Get your guild/server ID by enabling Developer Mode in Discord > right-click server > Copy ID
GUILD_ID=

# Web Server Port (default: 3000)
PORT=3000

# Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_TOKEN=super-secret-token-change-this-in-production
